-- Library Call
local component = require("component")
local term = require ("term")
local os = require ("os")
local event = require("event")
local sides = require("sides")

-- Transcendent Variable Establishment
local prevItems = {}
local stAmount = 0
local activationSignal = 0
local interface = component.me_interface
local redstone = component.proxy("07454d47-0f2f-496d-a628-1a0f798afd3a") -- Redstone I/O

-- Function to Prompt the User
local function ask(prompt)
    io.write(prompt.. " ")
    return io.read()
end

-- Function to Obtain Consumption Information
local function spacetimePrompt()
    stAmount = ask("Desired Spacetime Consumption Per Cycle:")
    stAmount = tonumber(stAmount)
end

-- Function to Find Value of "N" (But Y for sake of the program)
local function findY()
    local Y = 0
    while true do
        if (30*2^Y) > stAmount then
            return Y
        else
            Y = Y + 1
        end
    end
end    

-- Function to Sum Spacetime Series
local function sumSeries()
    local sum = 0
    for N = 0, (findY() - 1) do
        sum = sum + (30 * 2^(N))
    end
    return sum
end

-- Remainder Function
local function remainder()
    local remainderAmount = (stAmount/(30 * 2^findY())) * 30
    return remainderAmount
end

-- Function to Calculate Total Spacetime Consumption, Total Seconds Hole is Awake, & Parallel Efficiency
local function calculations()
    local totalAwakeTime = sumSeries() + remainder() + 90
    local parallelEfficiency = (1 - (80 / totalAwakeTime)) * 100
    print("Using "..stAmount.." Spacetime, Each Cycle will be "..totalAwakeTime.."(s) Operating at "..parallelEfficiency.."% Parallel Efficiency")
end

-- Function for Reading ME System
local function getItems()
    local items = {}
    for _, item in ipairs(interface.getItemsInNetwork()) do
        items[item.label] = item.size
    end
    return items
end

-- Item Check for Activation
local function checkForNewItem()
    while true do
    local currentItems = getItems()
        for label, count in pairs(currentItems) do
            if not prevItems[label] or count > prevItems[label] then
            print("Inputs Detected: " .. label)
            activationSignal = 1
            os.sleep(0.5)
                return
            end
        end
    prevItems = currentItems
    os.sleep(0.5)
    end
end

-- Clear Output Function
local function clearOutputs()
    print ("Clearing Previous Outputs")
    redstone.setOutput(sides.east,0)
    redstone.setOutput(sides.north,0)
    redstone.setOutput(sides.west,0)
    activationSignal = 0
    os.sleep(0.5)
end

-- Activation Check & Timekeeper
local function waitForActivation()
    print("Waiting for Activation Signal")
    while true do
        if activationSignal >= 1 then
            print ("Signal Found; Initiating Black Hole")
            redstone.setOutput(sides.east,15) -- Seed
            os.sleep(90)
            print ("Stability Has Reached 15%; Deploying Spacetime")
            redstone.setOutput(sides.north,15) -- Spacetime On/Off
            os.sleep(300) -- Spacetime Expenditure (s)
            print ("Spacetime Expenditure Too High; Closing Black Hole")
            redstone.setOutput(sides.west,15) -- Collapser
            return
        end
        os.sleep(0.5)
    end
end

-- Main Line --

-- Initial Loop for Establishing Uptime
while true do
    spacetimePrompt()
    calculations()
    local confirmation = ask("Is This Configuration Okay? [Y/N]: ")
    if confirmation == "Y" or "Yes" or "y" then
        break
    else
        term.clear
    end
end

-- Loop for Running Black Hole
while true do
    term.clear()
    print("Initiating Program, Use Ctrl+Alt+C to Exit")

    checkForNewItem()
    os.sleep(0.5)
    waitForActivation()
    os.sleep(0.5)
    clearOutputs()
    os.sleep(0.5)

end