-- Library Calls
local component = require("component")
local term = require ("term")
local os = require ("os")
local event = require("event")

-- Functionally Global Variables
local fluidNet = component.proxy("1b07d0dd-1072-44fa-baaf-fefb3d3d6a6d")
local itemNet = component.proxy("8fbc170a-fc07-490b-ad01-23865044ff62")
local combinedReadOnlyNet = component.proxy("Interface ID") -- Net for reading Item, Fluid, & Plasma
local mainNetInterface = component.proxy("e3c9ef7b-3652-4b56-b3e4-b31d0f3c813d")
local mainNetTransposer = component.proxy("ID")
local trashTransfer = component.proxy("ID")
local plasmaNet = component.proxy("Interface ID")
local data = component.database
local dbaddress = data.address
local meItemAmount = 0
local meFluidAmount = 0

-- Function to Wait for Program Activation
local function waitForActivation()
    print("Awaiting Activation; Use Ctrl + Alt + C to Exit Program")
    while true do 
        local activationItems = combinedReadOnlyNet.getItemsInNetwork()
        if #activationItems >= 1 then
            break
        else
            os.sleep(1)
        end
    end    
end

-- Function to Wait for Program Deactivation
local function waitForDeactivation()
    print("Awaiting Deactivation")
    while true do
        local deactivationItems = combinedReadOnlyNet.getItemsInNetwork()
        if #deactivationItems == 0 then
            break
        else
            os.sleep(1)
        end
    end
end

-- Function to Read Items in ItemNet
local function readItemNet()
    local meItems = itemNet.getItemsInNetwork()
    meItemAmount = 0
        for _, item in ipairs(meItems) do
            meItemAmount = meItemAmount + item.size
        end
    print("Detected Item in ItemNet")
    return meItemAmount
end

-- Function to Perform ItemNet  
local function itemToPlasma()
    while true do
        if readItemNet() ~= nil or 0 then -- Check for Item in Network
            break
        else
            os.sleep(1)
        end
    end
    print("Item found: ")

    local item = readItemNet()
    local itemName = item.label
    data.set(1,itemName) -- Set Database to Item
    local batchQuantity = readItemNet() * 9
    print("The Batchquantity for ITEM will be: "..batchQuantity)
    mainNetInterface.setInterfaceConfiguration(1, dbaddress, 1, batchQuantity) -- Set Interface to Request Items
    mainNetTransposer.getSlotStackSize(1)

end    

-- Function to Read Fluids in FluidNet
local function redFluidNet()
    local meFluids = fluidNet.getItemsInNetwork()
    meFluidAmount = 0
        for _, item in ipairs(meFluids) do
            meFluidAmount = meFluidAmount + item.size
        end
    print("Detected Fluid in FluidNet")
    return meFluidAmount
end


-- Main Line
while true do
    waitForActivation()

    readItemNet()
    itemToPlasma()

    waitForDeactivation()
    os.sleep(2)
end

