-- Function to Wait for Program Activation
local function waitForActivation()
    print("Awaiting Activation; Use Ctrl + Alt + C to Exit Program")
    while true do 
        local activationItems = combinedReadOnlyNet.getItemsInNetwork()
        if #activationItems >= 1 then
            break
        else
            os.sleep(1)
        end
    end    
end

-- Function to Wait for Program Deactivation
local function waitForDeactivation()
    print("Awaiting Deactivation")
    while true do
        local deactivationItems = combinedReadOnlyNet.getItemsInNetwork()
        if #deactivationItems == 0 then
            break
        else
            os.sleep(1)
        end
    end
end

