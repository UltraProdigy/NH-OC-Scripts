-- Library Callback
local component = require("component")
local term = require ("term")
local os = require ("os")
local sides = require("sides")

-- Variable Establishment
local transposer = component.transposer
local activationSignal = component.proxy("fd8989c2-7f1c-4f7b-9916-b2a2d0332ffc") -- Purification Activation Channel
local changeSignal = component.proxy("5ce6647c-28ad-4f7a-b059-438480cb8c14")

-- Function to Wait for Activation Signal
local function waitForActivation()
    while true do
        local signalStrength = activationSignal.getInput(sides.north)
        if signalStrength > 0 then
            print("Activation Signal Found, Beginning Lens Swap Procedure")
            break
        else
            os.sleep(1)
        end
    end
end

-- Function to send L1
local function L1()
    while true do
        local signalStrength = changeSignal.getInput(sides.bottom)
        if signalStrength > 0 then
            os.sleep(1)
            transposer.transferItem(sides.bottom,sides.top,1,1,9) -- Taking Out Dilithium(9)
            transposer.transferItem(sides.top,sides.bottom,1,1,1) -- Putting in Orundum(1)
            print("Inserted Orundum Lens")
            break
        else
            os.sleep(0.5)
        end
    end
end

