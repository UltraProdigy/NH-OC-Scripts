        local signalStrength = activationSignal.getInput(sides.north)
        if signalStrength == 0 then
            print("Goodnight Sweet Prince")
            break
        else
            os.sleep(1)
        end
    end
end

-- Main Program

while true do
    term.clear()
    print("Initiating Program; Use Ctrl + Alt + C to Escape")
    waitForActivation()
    L1()
        os.sleep(2)
    L2()
        os.sleep(2)
    L3()
        os.sleep(2)
    L4()
