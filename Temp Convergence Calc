-- Function to Prompt the User
local function ask(prompt)
    io.write(prompt.. " ")
    return io.read()
end

-- Function to Round Down to 0.05 Interval (Minecraft Tick Alignment)
local function roundDownToInterval(y)
    local result = math.floor(y/0.05) * 0.05
    return math.max(result,0.05)
end

-- Function to Round Down to 20 Interval (Recipe/Second Alignment)
local function roundDownToTwenty(a)
    return math.floor(a/20) * 20
end

-- Function to Round Up to nearest tenth
local function roundUpToTenths(z)
    return math.ceil(z*10) / 10
end

-- Overclock Function
local function overClock(x)
    x = tonumber(x)
    -- Function-Wide global variables
    local ocPower = 4^x
    local eut = baseEUt * ocPower
    local totalEU = baseEUt * baseTime * 20
    local totalOcEu = totalEU * 2^x
    local amps = math.ceil((baseEUt * ocPower)/voltageNumber)
    local iocTime = (baseTime/(2^x))
    local pocTime = (baseTime/(4^x))
    local iocRecipePerSecond = 0
    local pocRecipePerSecond = 0

    if iocTime >= 0.05 then
        iocTime = roundDownToInterval(iocTime)
        iocRecipePerSecond = (1/iocTime)
    elseif iocTime < 0.05 then
        iocRecipePerSecond = (1/iocTime)
        iocRecipePerSecond = roundDownToTwenty(iocRecipePerSecond)
    else
    end

    if pocTime >= 0.05 then
        pocTime = roundDownToInterval(pocTime)
        pocRecipePerSecond = (1/pocTime)
    elseif pocTime < 0.05 then
        pocRecipePerSecond = (1/pocTime)
        pocRecipePerSecond = roundDownToTwenty(pocRecipePerSecond)
    else
    end

    local iocCatalyst = catalystAmount * iocRecipePerSecond * 0.5 -- For 50% Discount
    local pocCatalyst = (pocRecipePerSecond * (catalystAmount * 0.5) + ((totalOcEu - totalEU) / (2 * catalystEnergy)))
    local iocOutputRate = primaryOutputAmount * iocRecipePerSecond
    local pocOutputRate = primaryOutputAmount * pocRecipePerSecond
    
    -- Titlecard

    io.write(x.." Imperfect (2/4) Overclock |")

    print("| "..x.." Perfect (4/4) Overclock (w/ Convergence)")
    -- Recipe EU/t & Amperage

    io.write("EU/t: "..string.format("%.2e",eut))
    print(" || Amperage Required: "..amps)
    -- Recipe Per Second Calculation

    io.write("Recipes Per Second: "..roundUpToTenths(iocRecipePerSecond).." |")

    print("| Recipes Per Second: "..roundUpToTenths(pocRecipePerSecond))
    -- Recipe Catalyst Requirements (L/s)

    io.write("Catalyst Rate Requirement: "..math.ceil(iocCatalyst).." L/s |")

    print("| Catalyst Rate Requirement: "..math.ceil(pocCatalyst).." L/s")
    -- Recipe Primary Output Amount (L/s)

    io.write("Primary Output Rate: "..math.ceil(iocOutputRate).." L/s |")

    print("| Primary Output Rate: "..math.ceil(pocOutputRate).." L/s")
    -- End of Line

    print(string.rep("=",158))
end

